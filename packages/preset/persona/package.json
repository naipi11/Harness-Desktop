{
  "name": "@stackstackstack/dsh-persona",
  "description": "Composition-authored deployment persona section for the DeepSeek Harness",
  "version": "0.1.8",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/preset/persona"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@stackstackstack/dsh-invariants": "workspace:^",
    "@stackstackstack/dsh-system-prompt": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@stackstackstack/dsh-invariants": "workspace:^",
    "@stackstackstack/dsh-scope": "workspace:^",
    "@stackstackstack/dsh-system-prompt": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  }
}
