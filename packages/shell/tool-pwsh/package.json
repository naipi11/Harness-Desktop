{
  "name": "@stackstackstack/dsh-tool-pwsh",
  "description": "Model-facing pwsh tool over the bash executor seam",
  "version": "0.1.8",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/shell/tool-pwsh"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@stackstackstack/dsh-agent": "workspace:^",
    "@stackstackstack/dsh-shell": "workspace:^",
    "@stackstackstack/dsh-shell-env": "workspace:^",
    "@stackstackstack/dsh-invariants": "workspace:^",
    "@stackstackstack/dsh-llm": "workspace:^",
    "@stackstackstack/dsh-sandbox": "workspace:^",
    "@stackstackstack/dsh-sandbox-policy": "workspace:^",
    "@stackstackstack/dsh-system-prompt": "workspace:^",
    "@stackstackstack/dsh-jobs": "workspace:^",
    "@stackstackstack/dsh-tools": "workspace:^",
    "@stackstackstack/dsh-user-approval": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@stackstackstack/dsh-agent": "workspace:^",
    "@stackstackstack/dsh-shell": "workspace:^",
    "@stackstackstack/dsh-shell-env": "workspace:^",
    "@stackstackstack/dsh-invariants": "workspace:^",
    "@stackstackstack/dsh-llm": "workspace:^",
    "@stackstackstack/dsh-loader-smoke": "workspace:^",
    "@stackstackstack/dsh-pwsh-local": "workspace:^",
    "@stackstackstack/dsh-sandbox": "workspace:^",
    "@stackstackstack/dsh-sandbox-policy": "workspace:^",
    "@stackstackstack/dsh-subprocess-local": "workspace:^",
    "@stackstackstack/dsh-system-prompt": "workspace:^",
    "@stackstackstack/dsh-jobs": "workspace:^",
    "@stackstackstack/dsh-jobs-local": "workspace:^",
    "@stackstackstack/dsh-tool-jobs": "workspace:^",
    "@stackstackstack/dsh-tools": "workspace:^",
    "@stackstackstack/dsh-user-approval": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  }
}
