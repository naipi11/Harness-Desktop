{
  "name": "@harness-desktop/dsh-client-ui-settings-plugins",
  "description": "Plugins settings section with feature-owned tabs and configurable host-plane plugin cards",
  "version": "1.0.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naipi11/Harness-Desktop.git",
    "directory": "packages/client/ui-settings-plugins"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@harness-desktop/dsh-client-connection",
        "@harness-desktop/dsh-client-locale",
        "@harness-desktop/dsh-client-runtime",
        "@harness-desktop/dsh-client-ui-settings",
        "@harness-desktop/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@harness-desktop/cordis": "workspace:^",
    "@harness-desktop/dsh-api-remotes": "workspace:^",
    "@harness-desktop/dsh-client-connection": "workspace:^",
    "@harness-desktop/dsh-client-locale": "workspace:^",
    "@harness-desktop/dsh-client-runtime": "workspace:^",
    "@harness-desktop/dsh-client-ui-primitives": "workspace:^",
    "@harness-desktop/dsh-client-ui-settings": "workspace:^",
    "@harness-desktop/dsh-client-ui-slots": "workspace:^",
    "@harness-desktop/dsh-client-web-react": "workspace:^",
    "@harness-desktop/dsh-invariants": "workspace:^",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@harness-desktop/cordis": "workspace:^",
    "@harness-desktop/dsh-api-remotes": "workspace:^",
    "@harness-desktop/dsh-client-connection": "workspace:^",
    "@harness-desktop/dsh-client-locale": "workspace:^",
    "@harness-desktop/dsh-client-runtime": "workspace:^",
    "@harness-desktop/dsh-client-test-runtime": "workspace:^",
    "@harness-desktop/dsh-client-ui-primitives": "workspace:^",
    "@harness-desktop/dsh-client-ui-settings": "workspace:^",
    "@harness-desktop/dsh-client-ui-slots": "workspace:^",
    "@harness-desktop/dsh-client-web-react": "workspace:^",
    "@harness-desktop/dsh-invariants": "workspace:^",
    "@types/react": "~18.3.1",
    "react": "^18.2.0"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "clsx": "^2.0.0"
  }
}
