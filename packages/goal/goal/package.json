{
  "name": "@harness-desktop/dsh-goal",
  "description": "Event-sourced same-session goal state and lifecycle service for the DeepSeek Harness",
  "version": "1.0.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naipi11/Harness-Desktop.git",
    "directory": "packages/goal/goal"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/types/client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@harness-desktop/dsh-agent": "workspace:^",
    "@harness-desktop/dsh-session-projection": "workspace:^",
    "@harness-desktop/dsh-brand": "workspace:^",
    "@harness-desktop/dsh-invariants": "workspace:^",
    "@harness-desktop/dsh-llm": "workspace:^",
    "@harness-desktop/dsh-scope": "workspace:^",
    "@harness-desktop/dsh-session": "workspace:^",
    "@harness-desktop/dsh-typert-protocol": "workspace:^",
    "@harness-desktop/cordis": "workspace:^"
  },
  "dependencies": {
    "@harness-desktop/schemastery": "workspace:^",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@harness-desktop/dsh-agent": "workspace:^",
    "@harness-desktop/dsh-session-projection": "workspace:^",
    "@harness-desktop/dsh-brand": "workspace:^",
    "@harness-desktop/dsh-invariants": "workspace:^",
    "@harness-desktop/dsh-llm": "workspace:^",
    "@harness-desktop/dsh-loader-smoke": "workspace:^",
    "@harness-desktop/dsh-scope": "workspace:^",
    "@harness-desktop/dsh-session": "workspace:^",
    "@harness-desktop/dsh-typert-protocol": "workspace:^",
    "@harness-desktop/cordis": "workspace:^"
  }
}
