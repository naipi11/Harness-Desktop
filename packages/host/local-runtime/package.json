{
  "name": "@harness-desktop/dsh-host-local-runtime",
  "description": "Harness Desktop local Runtime ownership and private endpoint foundation",
  "version": "1.0.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naipi11/Harness-Desktop.git",
    "directory": "packages/host/local-runtime"
  },
  "type": "module",
  "bin": {
    "harness-runtime": "lib/bin.js"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./legacy-import": {
      "types": "./lib/types/legacy-import.d.ts",
      "default": "./lib/legacy-import.js"
    },
    "./bin": "./lib/bin.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/bin.js",
    "lib/*.js",
    "runtime.cordis.yml",
    "lib/types/**/*.d.ts",
    "lib/agent-presets"
  ],
  "license": "MIT",
  "dependencies": {
    "@harness-desktop/dsh-subprocess": "workspace:^",
