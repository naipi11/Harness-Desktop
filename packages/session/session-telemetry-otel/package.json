{
  "name": "@harness-desktop/dsh-session-telemetry-otel",
  "description": "OpenTelemetry backend for the DeepSeek Harness telemetry seam: hands captured session records to the OTel JS SDK's log pipeline",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naipi11/Harness-Desktop.git",
    "directory": "packages/session/session-telemetry-otel"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.220.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.220.0",
    "@opentelemetry/otlp-exporter-base": "^0.220.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-logs": "^0.220.0",
    "@harness-desktop/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@harness-desktop/dsh-command-feedback": "workspace:^",
    "@harness-desktop/dsh-invariants": "workspace:^",
    "@harness-desktop/dsh-llm": "workspace:^",
    "@harness-desktop/dsh-session": "workspace:^",
    "@harness-desktop/dsh-session-telemetry": "workspace:^",
    "@harness-desktop/dsh-anonymous-user-id": "workspace:^",
    "@harness-desktop/dsh-host-local-runtime": "workspace:^",
    "@harness-desktop/cordis": "workspace:^"
  },
  "devDependencies": {
    "@harness-desktop/cordis-plugin-loader": "workspace:^",
    "@harness-desktop/dsh-command-feedback": "workspace:^",
    "@harness-desktop/dsh-invariants": "workspace:^",
    "@harness-desktop/dsh-llm": "workspace:^",
    "@harness-desktop/dsh-session": "workspace:^",
    "@harness-desktop/dsh-session-telemetry": "workspace:^",
    "@harness-desktop/dsh-anonymous-user-id": "workspace:^",
    "@harness-desktop/dsh-host-local-runtime": "workspace:^",
    "@harness-desktop/cordis": "workspace:^"
  }
}
