{
  "name": "@harness-desktop/dsh-credentials-platform",
  "description": "Runtime-only credential-reference provider: opaque references under HARNESS_HOME, values from a platform adapter",
  "version": "1.0.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naipi11/Harness-Desktop.git",
    "directory": "packages/credentials/credentials-platform"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@harness-desktop/dsh-atomic-write": "workspace:^",
    "@harness-desktop/dsh-credentials": "workspace:^",
    "@harness-desktop/dsh-launch-environment": "workspace:^",
    "@harness-desktop/dsh-invariants": "workspace:^",
    "@harness-desktop/cordis": "workspace:^"
  },
  "devDependencies": {
    "@harness-desktop/dsh-atomic-write": "workspace:^",
    "@harness-desktop/dsh-credentials": "workspace:^",
    "@harness-desktop/dsh-launch-environment": "workspace:^",
    "@harness-desktop/dsh-invariants": "workspace:^",
    "@harness-desktop/cordis": "workspace:^"
  }
}
