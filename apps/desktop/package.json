{
  "name": "@harness-desktop/dsh-desktop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "prepackage": "pnpm --dir ../.. run verify:icons",
    "package": "electron-builder --config electron-builder.config.mjs --publish never",
    "prepackage:dir": "pnpm --dir ../.. run verify:icons",
    "package:dir": "electron-builder --dir --config electron-builder.config.mjs --publish never",
    "test": "vitest run --root ../.. apps/desktop/tests",
    "test:e2e": "playwright test",
    "test:e2e:unpacked": "playwright test --config playwright.config.ts tests/desktop-dashboard.e2e.ts --grep unpacked"
  },
  "dependencies": {
    "@harness-desktop/cordis-plugin-group": "workspace:^",
    "@harness-desktop/dsh-anonymous-user-id": "workspace:^",
    "@harness-desktop/dsh-app-boot": "workspace:^",
    "@harness-desktop/dsh-atomic-write": "workspace:^",
    "@harness-desktop/dsh-bash-local": "workspace:^",
    "@harness-desktop/dsh-code-runtime": "workspace:^",
    "@harness-desktop/dsh-compaction": "workspace:^",
    "@harness-desktop/dsh-fs": "workspace:^",
    "@harness-desktop/dsh-host-local-runtime": "workspace:^",
    "@harness-desktop/dsh-home-paths": "workspace:^",
    "@harness-desktop/dsh-launch-environment": "workspace:^",
    "@harness-desktop/dsh-output-retention": "workspace:^",
    "@harness-desktop/dsh-pwsh-local": "workspace:^",
    "@harness-desktop/dsh-sandbox": "workspace:^",
    "@harness-desktop/dsh-scope": "workspace:^",
    "@harness-desktop/dsh-session-telemetry": "workspace:^",
    "@harness-desktop/dsh-session-title-llm": "workspace:^",
    "@harness-desktop/dsh-shell": "workspace:^",
    "@harness-desktop/dsh-spill": "workspace:^",
    "@harness-desktop/dsh-subagent-in-process-driver": "workspace:^",
    "@harness-desktop/dsh-subprocess": "workspace:^",
    "@harness-desktop/dsh-timeout": "workspace:^",
    "@harness-desktop/dsh-workflow": "workspace:^",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/react": "~18.3.31",
    "@types/react-dom": "~18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^6.0.3",
    "vite": "^7.0.0",
    "vitest": "^4.1.8"
  }
}
